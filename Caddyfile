{
	# Reachable from the backend container so a domain change can reload Caddy.
	#
	# Caddy's admin endpoint listens on localhost:2019 inside its own container
	# by default. This file never said otherwise, so the reload the backend has
	# always attempted -- POST http://caddy:2019/load -- was refused every
	# time, and an administrator saving a domain got "could not reload Caddy
	# automatically" with no way to tell why.
	#
	# Port 2019 is not published in docker-compose, so this is reachable from
	# the compose network and not from outside it.
	admin 0.0.0.0:2019
}

# Everything a Pinpoint site serves, in one place.
#
# The base domain below and any custom domain an administrator sets both import
# this, so there is exactly one Content-Security-Policy and one set of routes in
# the deployment. A custom domain used to be configured by regenerating this
# whole file from a template in the API handler, which dropped the headers, the
# tenant import and the panel block, and pointed the frontend at the Vite dev
# server.
(pinpoint_site) {

	# Access logging, to the caddy_data volume rather than to stdout.
	#
	# Caddy v2 writes no access log unless a site asks for one, and this file
	# never did -- so when a $135 translation bill arrived there was no record
	# of which requests had been served on the day in question, and the
	# container had since been recreated, taking its stdout with it. A log that
	# does not survive a deploy is not a log you can investigate with.
	#
	# /data is a named volume, so this outlives `up -d --force-recreate`.
	#
	# Resident IP addresses are personal data. Thirty days is the retention,
	# set here rather than left to grow: long enough to investigate a billing
	# surprise or an abuse report, short enough that it is not an archive of
	# who reported what and from where.
	log {
		output file /data/logs/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
	# Nothing this site accepts is larger than one phone photo. The resident
	# photo-screening endpoint is unauthenticated and multipart, and FastAPI
	# parses a multipart body -- spooling anything over 1MB to the container's
	# disk -- before the handler's own size check or the rate limiter can run.
	# So the ceiling has to sit in front of the application, and one anonymous
	# POST streaming an arbitrary body is refused here rather than filling a
	# disk and taking the instance down.
	#
	# The backend carries a matching limit of its own (MAX_REQUEST_BODY_BYTES),
	# because this file can be edited, regenerated for a custom domain, or
	# bypassed by anything already on the compose network.
	request_body {
		max_size 13MB
	}

	handle /api/* {
		# The backend sets a per-response CSP (locked-down for JSON, inline-safe
		# for its few HTML pages like demo/bootstrap login), so don't override it
		# here — a blanket lock would break those inline-script HTML pages.
		reverse_proxy {args[0]}
	}

	handle {
		reverse_proxy {args[1]}
	}

	encode gzip

	header {
		# Don't advertise server software/version (information disclosure).
		-Server
		-X-Powered-By
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		X-XSS-Protection "1; mode=block"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Maps is a switchable capability with four providers, and this header
		# decided which of them could actually run. Only Google's hosts were
		# listed, so selecting Esri, Azure or Apple got its SDK <script> refused
		# by the browser -- which surfaces as "the map does not load", not as a
		# policy error, and would have been debugged in the wrong place. Each
		# vendor's hosts are listed for its own SDK, stylesheet, fonts and
		# tile/API traffic:
		#
		#   js.arcgis.com          Esri SDK + theme CSS + its web workers
		#   *.arcgis.com           ArcGIS Online geocoding (geocode-api)
		#   *.arcgisonline.com     Esri basemap tiles and the static export used
		#                          by printed work orders
		#   atlas.microsoft.com    Azure Maps SDK, CSS and tiles
		#   cdn.apple-mapkit.com   MapKit JS
		#   *.apple-mapkit.com     MapKit tile and data endpoints
		#
		# A town on one provider never loads another's SDK -- the adapters are
		# behind dynamic imports -- so this widens what is *permitted*, not what
		# is fetched. The one case it cannot cover is a town whose ArcGIS
		# Enterprise locator lives on its own hostname: that is unknowable here,
		# and such a town still geocodes correctly server-side through
		# geocode_dispatch, which no browser policy applies to.
		#
		# connect-src also allows `blob:` and `data:`, which are not hosts and
		# are the two things that stopped an Esri town's markers and overlays
		# from drawing at all. The ArcGIS SDK does not hand either kind of URL
		# to an <img> or a Worker the way one would assume from img-src and
		# worker-src already permitting them -- it *fetches* both:
		#
		#   data:   a PictureMarkerSymbol's image is fetched and decoded before
		#           being uploaded as a WebGL texture. Every glyph in
		#           src/maps/markerIcons.ts is an SVG data URI (deliberately --
		#           that is what makes the same pin identical across providers),
		#           so refusing data: meant no request pin, no asset markers and
		#           no cluster bubbles on any Esri map.
		#   blob:   a GeoJSONLayer built from in-memory GeoJSON is serialised to
		#           a Blob and re-read through its blob: URL. Refusing it failed
		#           every addGeoJsonLayer call -- the township boundary when it
		#           is a multi-ring FeatureCollection, and every matched-asset
		#           and custom map layer.
		#
		# Both failures look exactly like a broken renderer: the basemap draws
		# fine because its tiles come from allowed https hosts. Google is
		# unaffected because it renders icons in <img> elements and its data
		# layer parses GeoJSON in-process, so this only ever bit the providers
		# that were added later.
		#
		# Neither scheme widens the origins reachable from the page: a blob: or
		# data: URL is same-origin content the page already holds.
		#
		# frame-src also carries Microsoft Forms, for the deployment
		# registration form an operator may host there (CONTACT_FORM_URL). The
		# console shows that form in a frame so a clerk can answer it without
		# leaving the page, and without this the frame is refused and renders as
		# a blank rectangle -- which looks like a broken console rather than a
		# policy decision. A form hosted anywhere else needs its own host added
		# here; setting CONTACT_FORM_EMBED=false is the alternative, and sends
		# people to a new tab instead.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://*.gstatic.com https://translate.googleapis.com https://cdn.jsdelivr.net https://js.arcgis.com https://atlas.microsoft.com https://cdn.apple-mapkit.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://js.arcgis.com https://atlas.microsoft.com; font-src 'self' https://fonts.gstatic.com https://js.arcgis.com https://atlas.microsoft.com data:; img-src 'self' data: blob: https: http:; connect-src 'self' https://maps.googleapis.com https://places.googleapis.com https://*.googleapis.com https://*.gstatic.com https://translate.googleapis.com https://api.open-meteo.com https://archive-api.open-meteo.com https://*.auth0.com https://fonts.googleapis.com https://js.arcgis.com https://*.arcgis.com https://*.arcgisonline.com https://atlas.microsoft.com https://cdn.apple-mapkit.com https://*.apple-mapkit.com blob: data: wss:; frame-src 'self' https://www.google.com https://*.auth0.com https://forms.office.com https://forms.microsoft.com; object-src 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob: https://js.arcgis.com https://atlas.microsoft.com;"
	}
}

# Dynamic domain from DOMAIN environment variable
# Set DOMAIN=your.domain.com in .env or docker-compose
{$DOMAIN:localhost} {
	import pinpoint_site backend:8000 frontend:80
}


# Centralized Hosting Orchestrator Control Panel
centraldemo.pinpoint311.org {
    encode gzip
    # Same log, same file. The panel provisions towns and holds the host's
    # shared credentials, so it is the site where "who called this, and when"
    # matters most.
    log {
        output file /data/logs/access.log {
            roll_size 50MiB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
    reverse_proxy orchestrator-panel-1:8100
}

# Provisioned Town Tenancies
# Provisioned town tenancies, and the snippet the backend writes when an
# administrator sets this town's own domain (custom-domain.caddy). One glob
# covers both -- importing the custom-domain file separately as well would
# define its site block twice, which Caddy refuses to start on.
import /etc/caddy/tenants/*.caddy

# Accessibility-testing clone of the demo (project pinpoint-a11y).
# Separate stack, separate database, no reports. Auth0 is deliberately absent
# there so the volunteer can reach staff screens through the bootstrap path
# instead of an SSO account. Same snippet as the demo so the headers, CSP and
# routing under test are the ones the real site ships.
noauthdemo.pinpoint311.org {
	import pinpoint_site pinpoint-a11y-backend-1:8000 pinpoint-a11y-frontend-1:80
}

# Second accessibility/demo clone (project pinpoint-passaic). Same shape as
# noauthdemo: own database seeded from it, no reports, no identity provider so
# the bootstrap gate stays open.
demomunicipality-hawthorne.pinpoint311.org {
	import pinpoint_site pinpoint-passaic-backend-1:8000 pinpoint-passaic-frontend-1:80
}
